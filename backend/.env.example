# ===========================================
# Innti Propuestas - Variables de Entorno
# ===========================================
# Copiar este archivo como .env y completar los valores

# --- Base de Datos ---
DATABASE_URL=sqlite:///./innti_propuestas.db

# --- Innti (IA Corporativa) ---
INNTI_API_BASE=https://litellm.quipux.com/v1
INNTI_API_KEY=sk-your-api-key-here
INNTI_MODEL=gpt-4o-mini

# --- Email (Notificaciones) ---
SMTP_HOST=smtp.quipux.com
SMTP_PORT=587
SMTP_USER=notificaciones@quipux.com
SMTP_PASSWORD=your-smtp-password
SMTP_FROM=notificaciones@quipux.com

# --- Portafolio ---
PORTFOLIO_FILE_PATH=../../../ListaPortafolio.xlsx

# --- App ---
APP_HOST=0.0.0.0
APP_PORT=8000
CORS_ORIGINS=http://localhost:5173
DEBUG=true
